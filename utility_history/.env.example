# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=utility_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── MongoDB ─────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=utility_db
MONGO_COLLECTION=sessions

# ── General ─────────────────────────────────────────────────
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=20
